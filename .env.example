# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (Azure PostgreSQL Flexible Server)
DB_HOST=clini-recall-db.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=clini_app
DB_PASSWORD=
DB_SSL=true

# SSL Certificate (REQUIRED in production when DB_SSL=true)
# Set to file path OR PEM content (starting with -----BEGIN CERTIFICATE-----)
# Download Azure CA: https://www.digicert.com/CACerts/DigiCertGlobalRootG2.crt.pem
DB_CA_CERT=

# Development only: allow insecure SSL when no CA cert provided
# WARNING: Never set this in production!
# DB_INSECURE_SSL=true

# Database Admin (for migrations)
DB_ADMIN_USER=clini_admin
DB_ADMIN_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Credential Encryption (generate with: openssl rand -base64 32)
CREDENTIALS_KEY_V1=
CREDENTIALS_CURRENT_KEY_VERSION=1
